{
  "name": "project-qingpu-pc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "npm run dev --prefix server & vite",
    "build": "vue-tsc -b && vite build",
    "build:pages": "vue-tsc -b && vite build --mode pages && cp dist/index.html dist/404.html",
    "deploy:pages": "npm run build:pages && npx gh-pages -d dist",
    "build:prod": "npm run build && npm install --prefix server --omit=dev",
    "start:prod": "NODE_ENV=production node server/src/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.17.0",
    "das-component-vue": "^1.2.18",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "pinia": "^3.0.1",
    "pinyin-engine": "^1.2.2",
    "three": "^0.185.1",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.0"
  }
}
